--cpu=Cortex-M4.fp.sp
"water_controller\startup_stm32f407xx.o"
"water_controller\main.o"
"water_controller\gpio.o"
"water_controller\dac.o"
"water_controller\usart.o"
"water_controller\stm32f4xx_it.o"
"water_controller\stm32f4xx_hal_msp.o"
"water_controller\stm32f4xx_hal_dac.o"
"water_controller\stm32f4xx_hal_dac_ex.o"
"water_controller\stm32f4xx_hal_rcc.o"
"water_controller\stm32f4xx_hal_rcc_ex.o"
"water_controller\stm32f4xx_hal_flash.o"
"water_controller\stm32f4xx_hal_flash_ex.o"
"water_controller\stm32f4xx_hal_flash_ramfunc.o"
"water_controller\stm32f4xx_hal_gpio.o"
"water_controller\stm32f4xx_hal_dma_ex.o"
"water_controller\stm32f4xx_hal_dma.o"
"water_controller\stm32f4xx_hal_pwr.o"
"water_controller\stm32f4xx_hal_pwr_ex.o"
"water_controller\stm32f4xx_hal_cortex.o"
"water_controller\stm32f4xx_hal.o"
"water_controller\stm32f4xx_hal_exti.o"
"water_controller\stm32f4xx_hal_uart.o"
