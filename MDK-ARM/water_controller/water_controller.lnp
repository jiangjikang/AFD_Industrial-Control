"water_controller\crc16.o"
"water_controller\modbus.o"
"water_controller\relay.o"
"water_controller\valve.o"
--strict --scatter "water_controller\water_controller.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "water_controller.map" -o water_controller\water_controller.axf